{
  "endpoint": "https://api.tiantoken.com/v1/chat/completions",
  "model": "gpt-6-sol",
  "reasoning_effort": "none",
  "test": "outputs/judge_bench_v3/test.jsonl",
  "train": "outputs/judge_bench_v3/train.jsonl",
  "output_dir": "outputs/judge_bench_v3/runs/gpt-6-sol-4shot",
  "api_key_env": "OPENAI_API_KEY",
  "env_file": ".env",
  "concurrency": 16,
  "max_completion_tokens": 16384,
  "temperature": 1.0,
  "top_p": 0.95,
  "presence_penalty": 1.5,
  "seed": 20261010,
  "request_timeout_seconds": 600,
  "transport_retries": 2,
  "recovery_structure_retries": 2,
  "bootstrap_repeats": 2000
}
