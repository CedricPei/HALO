# Shared request settings
LLM_TIMEOUT=300

# OpenAI-compatible Responses API (base URL must not end in /v1)
CREATOR_LLM_PROVIDER=openai
OPENAI_API_KEY=replace_me
OPENAI_BASE_URL=https://your-provider.example
OPENAI_MODEL=your-model-id
OPENAI_REASONING_EFFORT=high

# Gemini Developer API. Set CREATOR_LLM_PROVIDER=gemini for construction.
GEMINI_API_KEY=replace_me
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.5-flash
GEMINI_THINKING_LEVEL=high
EVALUATION_GEMINI_TRANSPORT=developer
