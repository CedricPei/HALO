# Local secrets and environment overrides
.env
.env.*
!.env.example
/.streamlit/secrets.toml

# Python caches and local environments
__pycache__/
*.py[cod]
.venv/
venv/

# Test, type-check, and coverage caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Benchmark runtime log
benchmark/build.log
evaluation/evaluation.log
eval_results/logs/

# Keep reproducibility evidence; generated working copies stay local.
/outputs/*
!/outputs/README.md
!/outputs/judge_bench_v*/
/outputs/judge_bench_v*/**/*.jsonl
/outputs/judge_bench_v*/**/items/
/outputs/judge_bench_v*/**/*.log
/outputs/judge_bench_v*/**/serve_*.py
/outputs/judge_bench_v*/**/*.tmp
/outputs/judge_bench_v*/**/*.lock

# Editor and operating-system files
.DS_Store
.idea/
.vscode/
*.swp

# Local-only project instructions and documents
/AGENTS.md
/*.docx
/*.pptx
/benchmark/*.docx

# Private annotation samples and local platform databases
/annotation_app/data/*-items.json
/annotation_app/data/*-items.json.gz
/annotation_app/data/*.sqlite
/annotation_app/data/*.sqlite-*
